            "/error"
          ]
        },
        "probe": {
          "template": "/api/orders",
          "method": "POST",
          "pathAnchor": "root",
          "side": "call"
        }
      },
      "expect": {
        "applies": false
      },
      "note": "A scoped limitation does not block error judgement for calls outside its scope."
    },
