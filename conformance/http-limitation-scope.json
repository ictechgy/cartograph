      "appliesTo": [
        "consumer",
        "producer"
      ],
      "input": {
        "scope": {
          "templates": [
            "/error"
          ]
        },
        "probe": {
          "template": "/error",
          "method": "PUT",
          "pathAnchor": "root",
          "side": "call"
        }
      },
      "expect": {
        "applies": true
      }
    },
    {
