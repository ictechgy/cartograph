{
  "format": "isthmus-conformance",
  "version": 1,
  "suite": "http-limitation-scope",
  "description": "Consumer reading of http limitationScopes (templates, templatePrefixes, templateSuffixes, methods): which calls (server/contract-side gaps) or declarations (client-side gaps) a scoped limitation applies to, and which scope entries are rejected. Comparisons are conservative over-approximations. Case ids are stable; producers vendor this file with its sha256 from SHA256SUMS.",
  "contract": "docs/GRAPH-EXCHANGE.md#http-limitation-스코프",
  "cases": [
    {
      "id": "applies/template-exact",
      "ruleId": "scope.applies",
      "provenance": "contract",
      "source": "docs/GRAPH-EXCHANGE.md#http-limitation-스코프",
      "appliesTo": [
        "consumer",
        "producer"
      ],
      "input": {
        "scope": {
          "templates": [
            "/error"
          ]
        },
        "probe": {
          "template": "/error",
          "method": "PUT",
          "pathAnchor": "root",
          "side": "call"
        }
      },
      "expect": {
        "applies": true
      }
    },
    {
      "id": "applies/template-other-path",
      "ruleId": "scope.applies",
      "provenance": "contract",
