    {
      "id": "suffix/proven-query-local",
      "ruleId": "compose.suffix",
      "provenance": "contract",
      "source": "docs/HTTP-WRAPPERS.md#공통-해석-규칙",
      "appliesTo": [
        "producer"
      ],
      "input": {
        "parts": [
