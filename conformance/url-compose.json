    {
      "id": "mask/high-entropy-id",
      "ruleId": "compose.mask",
      "provenance": "contract",
      "source": "docs/HTTP-WRAPPERS.md#공통-해석-규칙",
      "appliesTo": [
        "producer"
      ],
      "input": {
        "authority": "api.example.com",
