{
  "format": "isthmus-conformance",
  "version": 1,
  "suite": "url-compose",
  "description": "Shared producer rules for turning client URL expressions and declared HTTP wrapper calls into route-call templates: interpolation, query tails, base joins, stripping, masking, and wrapper argument binding.",
  "contract": "docs/HTTP-WRAPPERS.md",
  "cases": [
    {
      "id": "interpolation/whole-segment",
      "ruleId": "compose.interpolation",
      "provenance": "contract",
      "source": "docs/HTTP-WRAPPERS.md#공통-해석-규칙",
      "appliesTo": [
        "producer"
      ],
      "input": {
        "parts": [
          {
            "literal": "/api/v1/items/"
          },
          {
            "value": "id"
          }
        ]
      },
      "expect": {
        "template": "/api/v1/items/{}"
      }
    },
    {
      "id": "interpolation/middle-segment",
      "ruleId": "compose.interpolation",
      "provenance": "contract",
      "source": "docs/HTTP-WRAPPERS.md#공통-해석-규칙",
      "appliesTo": [
        "producer"
      ],
      "input": {
        "parts": [
          {
            "literal": "/users/"
          },
          {
            "value": "user"
          },
          {
            "literal": "/items/"
          },
          {
            "value": "item"
          }
        ]
      },
      "expect": {
        "template": "/users/{}/items/{}"
      }
    },
    {
      "id": "interpolation/partial-segment-is-dynamic",
      "ruleId": "compose.interpolation",
      "provenance": "contract",
      "source": "docs/HTTP-WRAPPERS.md#공통-해석-규칙",
      "appliesTo": [
        "producer"
      ],
      "input": {
        "parts": [
          {
            "literal": "/files/"
          },
          {
            "value": "name"
          },
          {
            "literal": ".json"
          }
        ]
      },
      "expect": {
        "channelPrefix": "/files/"
      },
      "expectDynamic": true,
      "note": "Only an interpolation that fills a whole segment becomes {}. Partial call segments are dynamic even though server templates may use p{}s."
    },
    {
      "id": "interpolation/glued-to-literal-is-dynamic",
      "ruleId": "compose.interpolation",
      "provenance": "contract",
      "source": "docs/HTTP-WRAPPERS.md#공통-해석-규칙",
      "appliesTo": [
        "producer"
      ],
      "input": {
        "parts": [
          {
            "literal": "/items"
          },
          {
            "value": "suffix"
          }
        ]
      },
      "expect": {
        "channelPrefix": "/items"
      },
      "expectDynamic": true
    },
    {
      "id": "interpolation/two-in-segment",
      "ruleId": "compose.interpolation",
      "provenance": "contract",
      "source": "docs/HTTP-WRAPPERS.md#공통-해석-규칙",
      "appliesTo": [
        "producer"
      ],
      "input": {
        "parts": [
          {
            "literal": "/v"
          },
          {
            "value": "major"
          },
          {
            "literal": "."
          },
          {
            "value": "minor"
          }
        ]
      },
      "expect": {
        "channelPrefix": "/v"
      },
      "expectDynamic": true
    },
    {
      "id": "interpolation/leading-value-is-base",
      "ruleId": "compose.interpolation",
      "provenance": "contract",
      "source": "docs/HTTP-WRAPPERS.md#공통-해석-규칙",
      "appliesTo": [
        "producer"
      ],
      "input": {
        "parts": [
          {
            "value": "baseUrl"
          },
          {
            "literal": "/items"
          }
        ]
      },
      "expectDynamic": true,
      "note": "A value before the first literal slash is a base expression; apply compose.base-join instead of this rule."
    },
    {
      "id": "query-tail/literal-question-mark",
      "ruleId": "compose.query-tail",
      "provenance": "contract",
      "source": "docs/HTTP-WRAPPERS.md#공통-해석-규칙",
      "appliesTo": [
        "producer"
      ],
      "input": {
        "parts": [
          {
            "literal": "/items?page="
          },
          {
            "value": "page"
          }
        ]
      },
      "expect": {
        "template": "/items",
        "queryTailStripped": true
      }
    },
    {
      "id": "query-tail/first-question-mark",
      "ruleId": "compose.query-tail",
      "provenance": "contract",
      "source": "docs/HTTP-WRAPPERS.md#공통-해석-규칙",
      "appliesTo": [
        "producer"
      ],
      "input": {
        "parts": [
          {
            "literal": "/search?q="
          },
          {
            "value": "q"
          },
          {
            "literal": "&next=/x?y"
          }
        ]
      },
      "expect": {
        "template": "/search",
        "queryTailStripped": true
      }
    },
    {
      "id": "query-tail/after-path-value",
      "ruleId": "compose.query-tail",
      "provenance": "contract",
      "source": "docs/HTTP-WRAPPERS.md#공통-해석-규칙",
      "appliesTo": [
        "producer"
      ],
      "input": {
        "parts": [
          {
            "literal": "/items/"
          },
          {
            "value": "id"
          },
          {
            "literal": "?expand=true"
          }
        ]
      },
      "expect": {
        "template": "/items/{}",
        "queryTailStripped": true
      }
    },
    {
      "id": "query-tail/fragment",
      "ruleId": "compose.query-tail",
      "provenance": "contract",
      "source": "docs/HTTP-WRAPPERS.md#공통-해석-규칙",
      "appliesTo": [
        "producer"
      ],
      "input": {
        "parts": [
          {
            "literal": "/docs#section"
          }
        ]
      },
      "expect": {
        "template": "/docs",
        "queryTailStripped": true
      }
    },
    {
      "id": "suffix/proven-query-local",
      "ruleId": "compose.suffix",
      "provenance": "contract",
      "source": "docs/HTTP-WRAPPERS.md#공통-해석-규칙",
      "appliesTo": [
        "producer"
      ],
      "input": {
        "parts": [
          {
            "literal": "/api/v1/articles"
          },
          {
            "queryTail": "suffix"
          }
        ]
      },
      "expect": {
        "template": "/api/v1/articles",
        "queryTailStripped": true
      },
      "note": "A trailing local whose initializer provably starts with '?' or is empty/orEmpty on every other branch is a query tail."
    },
    {
      "id": "suffix/unproven-local",
      "ruleId": "compose.suffix",
      "provenance": "contract",
      "source": "docs/HTTP-WRAPPERS.md#공통-해석-규칙",
      "appliesTo": [
        "producer"
      ],
      "input": {
        "parts": [
          {
            "literal": "/api/v1/articles"
          },
          {
            "value": "suffix"
          }
        ]
      },
      "expect": {
        "channelPrefix": "/api/v1/articles"
      },
      "expectDynamic": true
    },
    {
      "id": "suffix/query-local-not-last",
      "ruleId": "compose.suffix",
      "provenance": "contract",
      "source": "docs/HTTP-WRAPPERS.md#공통-해석-규칙",
      "appliesTo": [
        "producer"
      ],
      "input": {
        "parts": [
          {
            "literal": "/a"
          },
          {
            "queryTail": "q"
          },
          {
            "literal": "/b"
          }
        ]
      },
      "expect": {
        "channelPrefix": "/a"
      },
      "expectDynamic": true
    },
    {
      "id": "normalize/non-ascii-literal",
      "ruleId": "compose.normalize",
      "provenance": "contract",
      "source": "docs/HTTP-WRAPPERS.md#공통-해석-규칙",
      "appliesTo": [
        "producer"
      ],
      "input": {
        "parts": [
          {
            "literal": "/café/"
          },
          {
            "value": "id"
          }
        ]
      },
      "expect": {
        "template": "/caf%C3%A9/{}"
      }
    },
    {
      "id": "normalize/literal-brace",
      "ruleId": "compose.normalize",
      "provenance": "contract",
      "source": "docs/HTTP-WRAPPERS.md#공통-해석-규칙",
      "appliesTo": [
        "producer"
      ],
      "input": {
        "parts": [
          {
            "literal": "/tpl/{x}"
          }
        ]
      },
      "expect": {
        "template": "/tpl/%7Bx%7D"
      }
    },
    {
      "id": "base-join/rfc3986-absolute-path",
      "ruleId": "compose.base-join",
