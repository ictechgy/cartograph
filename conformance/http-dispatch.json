        "consumer",
        "producer"
      ],
      "input": {
        "document": {
          "dispatch": "registration-order",
          "facts": [
            {
              "method": "GET",
              "channel": "/items/{}/",
              "order": {
                "group": "django:shop.urls",
                "index": 0
