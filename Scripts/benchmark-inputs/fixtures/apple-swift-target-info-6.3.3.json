      "$DEVELOPER/Toolchains/XcodeDefault.xctoolchain/usr/lib/swift/iphonesimulator",
      "$DEVELOPER/Platforms/iPhoneSimulator.platform/Developer/SDKs/iPhoneSimulator.sdk/usr/lib/swift"
    ],
    "runtimeLibraryPaths": [
      "$DEVELOPER/Toolchains/XcodeDefault.xctoolchain/usr/lib/swift/iphonesimulator",
